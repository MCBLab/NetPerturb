/*
nf-test config for the end to end run only.

The default nf-test.config ignores tests/integration.nf.test so that
`nf-test test` stays fast and container free. `ignore` also blocks running the
file by path, so the opt-in run needs its own config:

    nf-test test -c nf-test.integration.config --tag integration --profile test,singularity
*/
config {

    testsDir "tests"
    workDir ".nf-test"
    configFile "tests/integration.nextflow.config"
}
