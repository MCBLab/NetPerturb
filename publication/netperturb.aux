\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Single-cohort run on the original van Galen labels} \citep  {vanGalen2019aml} (GENIE3 networks, antagonist mode, seed 1). (A) $\log _{10}$ perturbation score for all 55 targets, single genes on the left and joint targets on the right, across the 19 identities, with each malignant identity (\emph  {-like}) placed under its normal counterpart. A white dot marks the top identity for each target, and grey a pair without a score (the target has no edge in that identity's network). (B) Difference in $\log _{10}$ score between each malignant identity and its normal counterpart, one point per target scored in both; bars show medians; the blast-marker targets and BCL2 are coloured. (C) Identity main effect from a decomposition of $\log _{10}$ scores into target and identity effects, relative to B cells.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:vangalen}{{5}{12}{\textbf {Single-cohort run on the original van Galen labels} \citep {vanGalen2019aml} (GENIE3 networks, antagonist mode, seed 1). (A) $\log _{10}$ perturbation score for all 55 targets, single genes on the left and joint targets on the right, across the 19 identities, with each malignant identity (\emph {-like}) placed under its normal counterpart. A white dot marks the top identity for each target, and grey a pair without a score (the target has no edge in that identity's network). (B) Difference in $\log _{10}$ score between each malignant identity and its normal counterpart, one point per target scored in both; bars show medians; the blast-marker targets and BCL2 are coloured. (C) Identity main effect from a decomposition of $\log _{10}$ scores into target and identity effects, relative to B cells}{figure.5}{}}
