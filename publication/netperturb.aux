\@writefile{toc}{\contentsline {subsection}{Four AML cohorts processed with one command each}{5}{section*.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Four AML cohorts: design, reproducibility and network-size offsets} (cohorts of the \citet  {Zeng2025bonemarrowmap} atlas; GENIE3 networks, antagonist mode, 55 targets). (A) Identities scored per cohort, normal (N) and malignant (M, scMalignantFinder call), coloured by the number of cells the identity's network was built from; grey, not scored. (B) Mean $\log _{10}$ score of each target in one cohort against its mean over the other three; dashed line, identity. (C) Share of the variance of $\log _{10}$ scores explained by the target, by the identity, and left as the target $\times $ identity residual. (D) Identity-wide offset, the identity effect of a target + identity decomposition of $\log _{10}$ scores, against the number of cells in the identity's network; filled, malignant; dashed line, least-squares fit over all cohorts. (E) Spearman correlation over the six pairs of cohorts for the target mean, the identity offset and the target-specific effect (12 identities scored in every cohort), and for stem specificity (Fig.~\ref {fig:stem}B); bars, medians.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:cohorts}{{2}{6}{\textbf {Four AML cohorts: design, reproducibility and network-size offsets} (cohorts of the \citet {Zeng2025bonemarrowmap} atlas; GENIE3 networks, antagonist mode, 55 targets). (A) Identities scored per cohort, normal (N) and malignant (M, scMalignantFinder call), coloured by the number of cells the identity's network was built from; grey, not scored. (B) Mean $\log _{10}$ score of each target in one cohort against its mean over the other three; dashed line, identity. (C) Share of the variance of $\log _{10}$ scores explained by the target, by the identity, and left as the target $\times $ identity residual. (D) Identity-wide offset, the identity effect of a target + identity decomposition of $\log _{10}$ scores, against the number of cells in the identity's network; filled, malignant; dashed line, least-squares fit over all cohorts. (E) Spearman correlation over the six pairs of cohorts for the target mean, the identity offset and the target-specific effect (12 identities scored in every cohort), and for stem specificity (Fig.~\ref {fig:stem}B); bars, medians}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{Target-level scores replicate across cohorts}{7}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{Identity offsets follow network size}{7}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{Targets that consistently act on stem cells}{7}{section*.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Targets that act on stem identities.} The target-specific effect is the residual of the $\log _{10}$ score once target and identity effects are removed, per cohort. (A) Target-specific effect averaged over the identities of each compartment and then over cohorts; stem, HSC/MPP and LMPP; progenitor, cycling, lymphoid, granulocyte--monocyte, megakaryocyte--erythroid, eosinophil/basophil/mast and early erythroid progenitors; mature, all other identities. (B) Stem specificity, the target-specific effect in stem identities minus that in all other identities, per cohort (dots) and averaged over cohorts (diamonds); filled diamonds, same sign in all four cohorts and $P<0.05$ against 10,000 permutations of identity labels within each cohort. In A and B, targets are ordered by stem specificity, single genes above joint targets. (C) Target-specific effect in malignant against normal stem identities, averaged over cohorts (normal stem identities are absent from Beneyto-Calabuig); dashed line, identity. (D) Number of targets whose stem specificity has the same sign in all four cohorts, observed (line) and over 2,000 label permutations (histogram). (E) Stem specificity as defined in B against two alternative definitions: HSC/MPP alone as the stem compartment, and the within-identity rank of the target among the 55 in place of the residual; dark points, IL3RA, KIT and KDM1A.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:stem}{{3}{8}{\textbf {Targets that act on stem identities.} The target-specific effect is the residual of the $\log _{10}$ score once target and identity effects are removed, per cohort. (A) Target-specific effect averaged over the identities of each compartment and then over cohorts; stem, HSC/MPP and LMPP; progenitor, cycling, lymphoid, granulocyte--monocyte, megakaryocyte--erythroid, eosinophil/basophil/mast and early erythroid progenitors; mature, all other identities. (B) Stem specificity, the target-specific effect in stem identities minus that in all other identities, per cohort (dots) and averaged over cohorts (diamonds); filled diamonds, same sign in all four cohorts and $P<0.05$ against 10,000 permutations of identity labels within each cohort. In A and B, targets are ordered by stem specificity, single genes above joint targets. (C) Target-specific effect in malignant against normal stem identities, averaged over cohorts (normal stem identities are absent from Beneyto-Calabuig); dashed line, identity. (D) Number of targets whose stem specificity has the same sign in all four cohorts, observed (line) and over 2,000 label permutations (histogram). (E) Stem specificity as defined in B against two alternative definitions: HSC/MPP alone as the stem compartment, and the within-identity rank of the target among the 55 in place of the residual; dark points, IL3RA, KIT and KDM1A}{figure.3}{}}
