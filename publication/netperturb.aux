\@writefile{toc}{\contentsline {subsection}{Malignant and normal stem cells respond to different targets}{9}{section*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{Blast markers separate malignant cells from their normal counterparts}{9}{section*.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Malignant identities against their normal counterparts.} Each of the 30 matched pairs is a malignant identity (\emph  {-like}) and the normal identity of the same broad cell type in the same cohort; the difference is taken on the target-specific effect, so identity offsets cancel. (A) Malignant minus normal for each target over the 30 pairs (dots, coloured by cohort) and their mean (diamonds; filled, Wilcoxon signed-rank $P<0.05$); x axis cut at the 0.5th and 99.5th percentiles. Targets are ordered by the mean, single genes above joint targets. (B) Mean malignant-minus-normal difference of the blast markers KIT, FLT3 and CD33 minus that of the other targets, per pair, grouped by compartment. (C) Malignant minus normal for selected targets in the same pairs as B; white, a pair without a score.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:malignant}{{4}{10}{\textbf {Malignant identities against their normal counterparts.} Each of the 30 matched pairs is a malignant identity (\emph {-like}) and the normal identity of the same broad cell type in the same cohort; the difference is taken on the target-specific effect, so identity offsets cancel. (A) Malignant minus normal for each target over the 30 pairs (dots, coloured by cohort) and their mean (diamonds; filled, Wilcoxon signed-rank $P<0.05$); x axis cut at the 0.5th and 99.5th percentiles. Targets are ordered by the mean, single genes above joint targets. (B) Mean malignant-minus-normal difference of the blast markers KIT, FLT3 and CD33 minus that of the other targets, per pair, grouped by compartment. (C) Malignant minus normal for selected targets in the same pairs as B; white, a pair without a score}{figure.4}{}}
