/*
Resource caps for the end to end run.

conf/modules.config asks for 16 to 64 GB per network inference task, which is
sized for an HPC node rather than for the small test object. These caps keep the
run on a workstation.
*/

process {
    cpus   = 2
    memory = '8.GB'

    withName: DOWNSAMPLE    { cpus = 1; memory = '4.GB' }
    withName: GENIE3        { cpus = 2; memory = '8.GB' }
    withName: SCTENIFOLDNET { cpus = 2; memory = '8.GB' }
    withName: SCRANK        { cpus = 2; memory = '8.GB' }
    withName: HDWGCNA       { cpus = 2; memory = '8.GB' }
    withName: RANK_SCORE    { cpus = 2; memory = '8.GB' }
    withName: MERGE         { cpus = 1; memory = '1.GB' }
}
