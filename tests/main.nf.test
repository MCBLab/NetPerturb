/*
Workflow wiring tests. Every one runs with -stub, so no container is pulled and
no R executes. What they check is the shape of the pipeline: that --network
picks exactly one inference process, that --sctknk adds its own track beside
that choice (or runs alone without it), that every target becomes its own task,
and that the tables reach MERGE intact.

Trace tasks expose `name` as a public field rather than a getter, so it is read
with `it.@name`. The name carries the tag too, as in "RANK_SCORE (Brd4)".
*/
nextflow_pipeline {

    name "NetPerturb workflow"
    script "main.nf"

    test("genie3 runs GENIE3 and nothing else") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def processes = workflow.trace.tasks()
                .collect { it.@name.replaceFirst(/ \(.*/, "") }
                .unique()

            assert processes.contains("GENIE3")
            assert !processes.contains("SCTENIFOLDKNK_KO")
            assert !processes.contains("SCRANK")
            assert !processes.contains("HDWGCNA")
        }
    }

    test("hdwgcna runs HDWGCNA and nothing else") {

        options "-stub"

        when {
            params {
                obj       = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target    = "${projectDir}/testdata/test_input.txt"
                column    = "labels"
                species   = "mouse"
                n_cells   = 100
                n_cores   = 1
                network   = "hdwgcna"
                cut_ratio = 0.95
                outdir    = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def processes = workflow.trace.tasks()
                .collect { it.@name.replaceFirst(/ \(.*/, "") }
                .unique()

            assert processes.contains("HDWGCNA")
            assert !processes.contains("GENIE3")
            assert !processes.contains("SCTENIFOLDKNK_KO")
            assert !processes.contains("SCRANK")
        }
    }

    test("every target line becomes its own RANK_SCORE task") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            // testdata/test_input.txt holds Brd4, Cstdc5 and Stfa1;Mpo, and the
            // process tag puts the target it was handed into the task name
            def rankTasks = names.findAll { it.startsWith("RANK_SCORE") }
            assert rankTasks.size() == 3
            assert rankTasks.contains("RANK_SCORE (Brd4)")
            assert rankTasks.contains("RANK_SCORE (Cstdc5)")
            assert rankTasks.contains("RANK_SCORE (Stfa1;Mpo)")

            // one network per identity, two identities from the DOWNSAMPLE stub
            assert names.count { it.startsWith("GENIE3") } == 2

            // and a single MERGE gathering all of it
            assert names.count { it.startsWith("MERGE") } == 1
        }
    }

    test("MERGE collects every target into one table") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def merged = path("${outputDir}/rank_scores/perbscore_all_targets.txt")
            assert merged.exists()

            def lines = merged.readLines()

            // one header, then 3 targets x 2 identities from the stubs
            assert lines.size() == 7
            assert lines[0] == "cell_type\ttarget\tbinding\tperb_score"
            assert lines.count { it.startsWith("cell_type\t") } == 1

            // the ';' target survives the round trip through the file name
            assert lines.count { it.contains("Stfa1;Mpo") } == 2

            // the connection tables are merged alongside the scores
            def connections = path("${outputDir}/rank_scores/top_connections_all_targets.txt")
            assert connections.exists()

            def connection_lines = connections.readLines()
            assert connection_lines.size() == 7
            assert connection_lines[0] ==
                "cell_type\ttarget\tbinding\ttarget_gene\tpartner\tweight\trank"
            assert connection_lines.count { it.startsWith("cell_type\t") } == 1
        }
    }

    test("REPORT renders the merged table once MERGE finishes") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }
            assert names.count { it.startsWith("REPORT") } == 1

            assert path("${outputDir}/report/netperturb_report.html").exists()
        }
    }

    test("--sctknk runs scTenifoldKnk in parallel with the --network track") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                sctknk  = true
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            // the --network track is untouched: one GENIE3 per identity,
            // scored and reported exactly as it is without the flag
            assert names.count { it.startsWith("GENIE3") } == 2
            assert names.count { it.startsWith("RANK_SCORE") } == 3
            assert names.count { it.startsWith("REPORT") } == 1

            // and the sctknk track runs beside it: one network build per
            // identity, then one knockout per identity x target. test_input.txt
            // names Brd4, Cstdc5 and Stfa1;Mpo, so that is 3 targets across 2
            // identities. "SCTENIFOLDKNK_KO (" counts the knockouts alone.
            assert names.count { it.startsWith("SCTENIFOLDKNK_BUILD") } == 2
            // and one null model per identity, which every knockout of it reads
            assert names.count { it.startsWith("SCTENIFOLDKNK_NULL") } == 2
            def knkTasks = names.findAll { it.startsWith("SCTENIFOLDKNK_KO (") }
            assert knkTasks.size() == 6
            assert names.count { it.startsWith("MERGE_SCTENIFOLDKNK") } == 1

            // "Stfa1;Mpo" is one joint knockout per identity, not split
            assert knkTasks.contains("SCTENIFOLDKNK_KO (resistant:Stfa1;Mpo)")
            assert knkTasks.contains("SCTENIFOLDKNK_KO (sensitive:Stfa1;Mpo)")
            assert !knkTasks.contains("SCTENIFOLDKNK_KO (resistant:Stfa1)")

            // the same target RANK_SCORE scores
            assert names.contains("RANK_SCORE (Stfa1;Mpo)")

            // neither of the other two inference methods is dragged in
            assert !names.any { it.startsWith("SCRANK") }
            assert !names.any { it.startsWith("HDWGCNA") }

            assert path("${outputDir}/sctknk/sctenifoldknk_all_targets.txt").exists()
            assert path("${outputDir}/sctknk/sctenifoldknk_status.txt").exists()
            assert path("${outputDir}/report/netperturb_report.html").exists()
        }
    }

    test("--cell_subset narrows both tracks to the named identities") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                sctknk  = true
                cell_subset = "sensitive"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            // the scoring track builds the one identity asked for, and still
            // scores every target over it and reports once
            assert names.count { it.startsWith("GENIE3") } == 1
            assert names.count { it.startsWith("RANK_SCORE") } == 3
            assert names.count { it.startsWith("REPORT") } == 1

            // and so does the knockout track: its null model and the 3
            // knockouts follow from that network alone
            assert names.count { it.startsWith("SCTENIFOLDKNK_BUILD") } == 1
            assert names.contains("SCTENIFOLDKNK_BUILD (sensitive)")
            assert names.count { it.startsWith("SCTENIFOLDKNK_NULL") } == 1
            assert names.contains("SCTENIFOLDKNK_NULL (sensitive)")
            def knkTasks = names.findAll { it.startsWith("SCTENIFOLDKNK_KO (") }
            assert knkTasks.size() == 3
            assert knkTasks.every { it.startsWith("SCTENIFOLDKNK_KO (sensitive:") }
            assert names.count { it.startsWith("MERGE_SCTENIFOLDKNK") } == 1

            // no --extra_target, no check of one
            assert !names.any { it.startsWith("EXTRA_TARGET_QC") }

            // and nothing was said about a missing identity. nf-test runs
            // Nextflow quietly, so a WARN never reaches workflow.stdout; the
            // run's log, kept beside the output directory, is where it lands.
            assert !path("${outputDir}/../meta/nextflow.log").text.contains("--cell_subset names")

            assert path("${outputDir}/sctknk/sctenifoldknk_all_targets.txt").exists()
            assert path("${outputDir}/report/netperturb_report.html").exists()
        }
    }

    test("a --cell_subset name with no identity is warned about, the rest run") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                sctknk  = true
                // a space after the comma, to show the names are trimmed
                cell_subset = "resistant, Mono"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            // resistant runs in both tracks, Mono matches no split object
            assert names.count { it.startsWith("GENIE3") } == 1
            assert names.count { it.startsWith("SCTENIFOLDKNK_BUILD") } == 1
            assert names.contains("SCTENIFOLDKNK_BUILD (resistant)")
            assert names.count { it.startsWith("SCTENIFOLDKNK_KO (") } == 3
            assert names.count { it.startsWith("MERGE_SCTENIFOLDKNK") } == 1

            // and the run says which name matched nothing (a WARN, so in the
            // run's log rather than the quiet stdout nf-test captures)
            assert path("${outputDir}/../meta/nextflow.log").text.contains(
                "--cell_subset names Mono, which DOWNSAMPLE did not keep")
        }
    }

    test("a --cell_subset matching no identity stops the run") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                sctknk  = true
                cell_subset = "HSC,Mono"
                outdir  = "${outputDir}"
            }
        }

        then {
            // rather than tracks that build nothing and a REPORT that never
            // runs, the run fails and names the identities it had
            assert workflow.failed
            assert workflow.stdout.any { it.contains("No identity matches --cell_subset 'HSC,Mono'") }
            assert workflow.stdout.any { it.contains("DOWNSAMPLE kept: resistant, sensitive") }

            def names = workflow.trace.tasks().collect { it.@name }
            assert !names.any { it.startsWith("GENIE3") }
            assert !names.any { it.startsWith("SCTENIFOLDKNK_BUILD") }
        }
    }

    test("--extra_target runs the extras the networks carry in both tracks") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                sctknk  = true
                // Gata1 is new, AbsentGene stands in (in the stub) for a gene
                // no network carries, and Brd4 is already a --target
                extra_target = "${projectDir}/tests/fixtures/extra_targets.txt"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            // the extras never reach DOWNSAMPLE or a network step: one of
            // each, as without them
            assert names.count { it.startsWith("DOWNSAMPLE") } == 1
            assert names.count { it.startsWith("GENIE3") } == 2
            assert names.count { it.startsWith("SCTENIFOLDKNK_BUILD") } == 2
            assert names.count { it.startsWith("SCTENIFOLDKNK_NULL") } == 2

            // one check per track
            assert names.contains("EXTRA_TARGET_QC_RANK (rank_score)")
            assert names.contains("EXTRA_TARGET_QC_KNOCKOUT (knockout)")

            // Gata1 joins the 3 targets in both tracks; Brd4 runs once and
            // AbsentGene not at all
            assert names.count { it.startsWith("RANK_SCORE") } == 4
            assert names.contains("RANK_SCORE (Gata1)")
            assert names.count { it == "RANK_SCORE (Brd4)" } == 1
            assert !names.any { it.contains("AbsentGene") }
            def knkTasks = names.findAll { it.startsWith("SCTENIFOLDKNK_KO (") }
            assert knkTasks.size() == 8
            assert knkTasks.count { it.endsWith(":Gata1)") } == 2

            // the gene that was not run is listed, per track, for the report
            def qc = path("${outputDir}/qc/extra_target_qc_rank_score.tsv").readLines()
            assert qc.any { it.contains("AbsentGene") && it.endsWith("not run") }
            assert path("${outputDir}/qc/extra_target_qc_knockout.tsv").readLines()
                .any { it.contains("AbsentGene") && it.endsWith("not run") }
            assert path("${outputDir}/report/netperturb_report.html").exists()
        }
    }

    test("--extra_target with --sctknk alone checks only the knockout track") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                sctknk  = true
                extra_target = "${projectDir}/tests/fixtures/extra_targets.txt"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }
            assert names.contains("EXTRA_TARGET_QC_KNOCKOUT (knockout)")
            assert !names.any { it.startsWith("EXTRA_TARGET_QC_RANK") }
            assert names.count { it.startsWith("SCTENIFOLDKNK_KO (") } == 8
            assert !names.any { it.startsWith("REPORT") }
        }
    }

    test("an --extra_target file that does not exist stops the run") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                extra_target = "${projectDir}/tests/fixtures/no_such_file.txt"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.failed
            assert !workflow.trace.tasks().any { it.@name.startsWith("DOWNSAMPLE") }
        }
    }

    test("--sctknk_plot publishes one plotKO() PDF per knockout") {

        options "-stub"

        when {
            params {
                obj         = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target      = "${projectDir}/testdata/test_input.txt"
                column      = "labels"
                species     = "mouse"
                n_cells     = 100
                n_cores     = 1
                sctknk      = true
                sctknk_plot = true
                outdir      = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            // 3 targets x 2 identities, the joint Stfa1;Mpo knockout included,
            // named off the same sanitised target as the tables
            def plots = path("${outputDir}/sctknk/plots").list().collect { it.fileName.toString() }
            assert plots.size() == 6
            assert plots.contains("sensitive_sctknk_plot_Stfa1_Mpo.pdf")

            // the merged table is still there, beside the plots directory
            assert path("${outputDir}/sctknk/sctenifoldknk_all_targets.txt").exists()
        }
    }

    test("--sctknk without --network runs the knockout track alone") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                sctknk  = true
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            assert names.count { it.startsWith("SCTENIFOLDKNK_BUILD") } == 2
            assert names.count { it.startsWith("SCTENIFOLDKNK_KO (") } == 6
            assert names.count { it.startsWith("MERGE_SCTENIFOLDKNK") } == 1

            // the merge publishes its three tables -- the merged knockout
            // table, the per-knockout summary and the status lines -- and the
            // per-pair tables stay in the work dir. Three rather than four
            // because no --gsea_gmt was given -- the enrichment publishes
            // beside them when there is one.
            assert path("${outputDir}/sctknk/sctenifoldknk_all_targets.txt").exists()
            assert path("${outputDir}/sctknk/sctenifoldknk_summary.txt").exists()
            assert path("${outputDir}/sctknk/sctenifoldknk_status.txt").exists()
            assert path("${outputDir}/sctknk").list().size() == 3

            // no --network, so the whole scoring and reporting track stays off
            assert !names.any { it.startsWith("GENIE3") }
            assert !names.any { it.startsWith("SCRANK") }
            assert !names.any { it.startsWith("HDWGCNA") }
            assert !names.any { it.startsWith("RANK_SCORE") }
            assert !names.any { it.startsWith("REPORT") }
            // MERGE_SCTENIFOLDKNK also starts with "MERGE", so match it exactly
            assert !names.any { it.replaceFirst(/ \(.*/, "") == "MERGE" }
        }
    }

    test("an unsupported --network fails before doing any work") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "wgcna"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.failed

            // the guard reports on stdout, not in the error report
            assert workflow.stdout.any { it.contains("Invalid --network 'wgcna'") }

            // and it stops the run before a single task is launched
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("sctknk is no longer a --network value") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "sctknk"
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.failed

            // it moved to its own flag, so --network sctknk is now just a typo
            assert workflow.stdout.any { it.contains("Invalid --network 'sctknk'") }
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("neither --network nor --sctknk leaves nothing to run") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.failed

            assert workflow.stdout.any { it.contains("Nothing to run.") }
            assert workflow.trace.tasks().isEmpty()
        }
    }

    test("--gsea_gmt adds gene set enrichment to the knockout track") {

        options "-stub"

        when {
            params {
                obj      = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target   = "${projectDir}/testdata/test_input.txt"
                column   = "labels"
                species  = "mouse"
                n_cells  = 100
                n_cores  = 1
                network  = "genie3"
                sctknk   = true
                gsea_gmt = "${projectDir}/tests/fixtures/test_sets.gmt"
                outdir   = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            assert names.count { it.startsWith("GSEA_SCTENIFOLDKNK") } == 1
            assert path("${outputDir}/sctknk/gsea_all_targets.txt").exists()

            // published beside the merge's three tables, so the directory now
            // holds four -- the knockout-alone test above asserts three for
            // want of a GMT
            assert path("${outputDir}/sctknk").list().size() == 4

            // the knockout fan-out and the scoring track are untouched by it.
            // GSEA_SCTENIFOLDKNK starts with "GSEA_", so it cannot inflate this
            // count -- which is why the process is not named SCTENIFOLDKNK_GSEA
            assert names.count { it.startsWith("SCTENIFOLDKNK_KO (") } == 6
            assert names.count { it.startsWith("REPORT") } == 1
        }
    }

    test("no --gsea_gmt means no enrichment task and a sentinel into REPORT") {

        options "-stub"

        when {
            params {
                obj     = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target  = "${projectDir}/testdata/test_input.txt"
                column  = "labels"
                species = "mouse"
                n_cells = 100
                n_cores = 1
                network = "genie3"
                sctknk  = true
                outdir  = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            assert !names.any { it.startsWith("GSEA") }
            assert !path("${outputDir}/sctknk/gsea_all_targets.txt").exists()

            // REPORT still runs: it takes assets/NO_GSEA_TABLE instead
            assert names.count { it.startsWith("REPORT") } == 1
        }
    }

    test("--gsea_gmt without --sctknk runs no enrichment and does not fail") {

        options "-stub"

        when {
            params {
                obj      = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target   = "${projectDir}/testdata/test_input.txt"
                column   = "labels"
                species  = "mouse"
                n_cells  = 100
                n_cores  = 1
                network  = "genie3"
                gsea_gmt = "${projectDir}/tests/fixtures/test_sets.gmt"
                outdir   = "${outputDir}"
            }
        }

        then {
            // warned rather than fatal: there is no knockout table to enrich,
            // but the scoring track is perfectly valid on its own
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            assert !names.any { it.startsWith("GSEA") }
            assert !names.any { it.startsWith("SCTENIFOLDKNK") }
            assert names.count { it.startsWith("REPORT") } == 1
        }
    }

    test("the knockout track enriches on its own, with no report to put it in") {

        options "-stub"

        when {
            params {
                obj      = "${projectDir}/tests/fixtures/dummy_obj.rds"
                target   = "${projectDir}/testdata/test_input.txt"
                column   = "labels"
                species  = "mouse"
                n_cells  = 100
                n_cores  = 1
                sctknk   = true
                gsea_gmt = "${projectDir}/tests/fixtures/test_sets.gmt"
                outdir   = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            def names = workflow.trace.tasks().collect { it.@name }

            assert names.count { it.startsWith("GSEA_SCTENIFOLDKNK") } == 1
            assert path("${outputDir}/sctknk/gsea_all_targets.txt").exists()

            // no --network, so nothing renders it -- the same gap the knockout
            // table itself has in this mode
            assert !names.any { it.startsWith("REPORT") }
        }
    }

}
