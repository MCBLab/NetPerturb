/*
Configuration applied on top of nextflow.config for every nf-test run.

conf/modules.config requests up to 64 GB for the network inference steps, which
no laptop or CI runner will grant. withName selectors beat a generic process
block, so each one has to be overridden by name.
*/

params {
    n_cores = 1
}

process {
    cpus   = 1
    memory = '1.GB'

    withName: DOWNSAMPLE    { cpus = 1; memory = '1.GB' }
    withName: GENIE3        { cpus = 1; memory = '1.GB' }
    withName: SCTENIFOLDNET { cpus = 1; memory = '1.GB' }
    withName: SCRANK        { cpus = 1; memory = '1.GB' }
    withName: HDWGCNA       { cpus = 1; memory = '1.GB' }
    withName: RANK_SCORE    { cpus = 1; memory = '1.GB' }
    withName: MERGE         { cpus = 1; memory = '1.GB' }
}
