/*
Both cases run with -stub, and REPORT's stub only touches the HTML -- no quarto
and no R execute. So these check the process contract (that the declared inputs
and the emitted file line up) and nothing about the report's contents. The
template itself is only exercised by rendering it in the rquarto container; see
the note in tests/main.nf.test.
*/
nextflow_process {

    name "REPORT"
    script "modules/local/report/main.nf"
    process "REPORT"

    test("renders the merged table into a single HTML report") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("\${projectDir}/tests/fixtures/perbscore_all_targets.Brd4.txt")
                input[1] = file("\${projectDir}/tests/fixtures/umap.png")
                input[2] = file("\${projectDir}/bin/report.qmd")
                input[3] = "genie3"
                input[4] = 0.75
                input[5] = file("\${projectDir}/tests/fixtures/sctenifoldknk_all_targets.txt")
                input[6] = 25
                """
            }
        }

        then {
            assert process.success
            assert process.out.report.size() == 1
            assert file(process.out.report[0]).name == "netperturb_report.html"
        }
    }

    test("accepts the sentinel table from a run without --sctknk") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("\${projectDir}/tests/fixtures/perbscore_all_targets.Brd4.txt")
                input[1] = file("\${projectDir}/tests/fixtures/umap.png")
                input[2] = file("\${projectDir}/bin/report.qmd")
                input[3] = "genie3"
                input[4] = 0.75
                input[5] = file("\${projectDir}/assets/NO_SCTKNK_TABLE")
                input[6] = 25
                """
            }
        }

        then {
            assert process.success
            assert process.out.report.size() == 1
        }
    }
}
