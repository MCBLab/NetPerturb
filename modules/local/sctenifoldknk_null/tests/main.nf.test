nextflow_process {

    name "SCTENIFOLDKNK_NULL"
    script "modules/local/sctenifoldknk_null/main.nf"
    process "SCTENIFOLDKNK_NULL"

    test("writes one null model per cell type") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("\${projectDir}/tests/fixtures/sensitive.RDS").copyTo("sensitive_sctknk_wt.rds")
                input[1] = file("\${projectDir}/testdata/test_input.txt")
                input[2] = 50
                input[3] = 1
                input[4] = 1
                input[5] = 2
                """
            }
        }

        then {
            assert process.success
            assert process.out.null_model.size() == 1
            assert file(process.out.null_model[0]).name == "sensitive_sctknk_null.rds"
        }
    }
}
