nextflow_process {

    name "DOWNSAMPLE"
    script "modules/local/downsample_and_split/main.nf"
    process "DOWNSAMPLE"

    test("emits one object per cell identity") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("\${projectDir}/tests/fixtures/dummy_obj.rds")
                input[1] = file("\${projectDir}/testdata/test_input.txt")
                input[2] = "labels"
                input[3] = "mouse"
                input[4] = 100
                input[5] = 150
                input[6] = "RNA"
                input[7] = 2000
                input[8] = 1
                """
            }
        }

        then {
            assert process.success

            // the glob emits every identity as one list, which is why main.nf
            // has to flatten this channel before fanning out to the network step
            assert process.out.scrank_obj.size() == 1

            def names = process.out.scrank_obj[0].collect { file(it).name }.sort()
            assert names == ["resistant.RDS", "sensitive.RDS"]

            // one row per identity, for the report's cell count figure
            def counts = file(process.out.cell_counts[0]).readLines()
            assert counts[0] == "identity\tn_input\tn_used\tstatus\tgenes_total\tgenes_gene4use\tgenes_expressed\tgenes_filtered"
            assert counts.size() == 3

            // one row per identity x single target gene, for the expression heatmap
            def expr = file(process.out.target_expression[0]).readLines()
            assert expr[0] == "identity\tgene\tavg_expression\tpct_expressing"
        }
    }
}
