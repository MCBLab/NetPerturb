manifest {
    name            = 'diegomscoelho/nf_scrank'
    author          = """Diego Coelho"""
    homePage        = 'https://github.com/diegomscoelho/nf_scrank'
    description     = """A pipeline for modelling single-cell RNA-seq data perturbation using scRANK"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.1'
    version         = '0.1.0dev'
    doi             = ''
}


params {

    // Input options
    seuObj  = null
    column  = null
    species = null
    target  = null
    network = null

    // Seurat assay holding the counts. Every network method reads an assay
    // named "RNA", so any other one given here is renamed to "RNA" on load
    // (replacing an existing "RNA" assay), e.g. "originalexp" for an object
    // converted from a SingleCellExperiment.
    assay   = 'RNA'

    // Downsampling options
    // Fewest cells a cellular identity must contribute for DOWNSAMPLE to keep
    // it. Counted after downsampling -- min(identity size, --n_cells) -- since
    // that is what every network method downstream actually sees, which is
    // also what --hdwgcna_min_cells is measured against. An identity below it
    // is dropped before it is split out, so no network is inferred from it and
    // it appears in no table or figure.
    min_cells = 150

    // Adds the SCTENIFOLDKNK track, which runs in parallel with whichever
    // rank-score method --network selects and feeds its differentially-
    // regulated gene table into that run's REPORT. With --sctknk and no
    // --network it runs alone (table only, no RANK_SCORE/REPORT).
    sctknk = false

    // Number of strongest edges kept per target per cell type by RANK_SCORE
    top_connections = 15

    // Genes drawn around each knockout target in the report's network figure,
    // taken from those clearing FDR < 0.05 and ranked on log2FC. The table in
    // the section below that figure is never capped.
    sctknk_top_genes = 25

    // GSEA options
    // Gene sets for the enrichment run over the knockout track's DR table, as
    // a GMT file. A file rather than a web service so the step works on a node
    // with no internet; null means no enrichment, and the report says so. The
    // symbols have to match --species: MSigDB's mouse collections use MGI
    // symbols, its human ones HGNC.
    gsea_gmt = null

    // Gene set size bounds after intersecting with the ranked list. The lower
    // bound is below the conventional 15 on purpose: the DR table only covers
    // gene4use, a few thousand genes rather than the transcriptome, so sets
    // shrink hard against it.
    gsea_min_size = 10
    gsea_max_size = 500

    // Gene sets drawn per combination in the report's enrichment dot plot,
    // taken from those clearing FDR < 0.25 -- GSEA's own significance
    // convention, looser than the 0.05 the DR table is cut at -- and ranked on
    // |NES|, so both ends of a two-tailed ranking survive the cap. The table
    // below that figure is never capped.
    gsea_top_terms = 20

    // Built from container/gsea/Dockerfile. Point it at a local .sif if the
    // image has not been pushed anywhere.
    gsea_container = 'diegomscoelho/netperturb-gsea:1.0'

    // Report options
    // Pooled perturbation scores are bimodal; the report keeps only the high
    // mode, cutting at this quantile of the pooled log10 scores.
    score_quantile = 0.75

    // hdWGCNA options
    // cut_ratio is the quantile of |edge weight| below which edges are cut,
    // matching the default used by scRank's own Constr_net
    cut_ratio         = 0.95
    hdwgcna_min_cells = 150

    // Boilerplate options
    outdir                     = "results"
    tracedir                   = "${params.outdir}/pipeline_info"
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = 'genomes'
    trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                 = '500.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

}

// 'binding' collides with the Script.binding property inside a params block,
// so it is set here rather than as a bare key
params.binding = "antagonist"

params.validationSkipDuplicateCheck = false
params.validationS3PathCheck = false


// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag_${params.trace_report_suffix}.html"
}

profiles {
    debug { process.beforeScript = 'echo $HOSTNAME' }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    podman {
        podman.enabled         = true
        docker.enabled         = false
        singularity.enabled    = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    shifter {
        shifter.enabled        = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        charliecloud.enabled   = false
    }
    charliecloud {
        charliecloud.enabled   = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
    }
    gitpod {
        executor.name          = 'local'
        executor.cpus          = 16
        executor.memory        = 60.GB
    }

    test      { includeConfig 'conf/test.config'      }
    test_ocasio      { includeConfig 'conf/test_ocasio.config'      }
    test_vangalen    { includeConfig 'conf/test_vangalen.config'    }

}


// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

