process {   
  
 withName: DOWNSAMPLE {  
        memory = { 16.GB }
    }
   
 withName: GENIE3 {
	memory = { 150.GB }
        cpus = {$params.n_cores}
        time = { 72.h * task.attempt }
        maxRetries = 2
        publishDir = [
            path: { "${params.outdir}/genie3/" },
            mode: 'copy'
        ]
    }

 withName: SCTENIFOLDNET {
	memory = { 16.GB }
        cpus = {$params.n_cores}
        publishDir = [
            path: { "${params.outdir}/sctnet/" },
            mode: 'copy'
        ]
    }

 withName: SCRANK {
	memory = { 64.GB }
        cpus = {$params.n_cores}
        time = { 72.h * task.attempt }
        maxRetries = 2
        publishDir = [
            path: { "${params.outdir}/scrank/" },
            mode: 'copy'
        ]
    }

 withName: RANK_SCORE {
        memory = { 100.GB }
        time = { 24.h * task.attempt }
        maxRetries = 2
        publishDir = [
            path: { "${params.outdir}/rank_scores/" },
            mode: 'copy'
        ]
    }

 withName: MERGE {
        memory = { 2.GB }
        publishDir = [
            path: { "${params.outdir}/rank_scores/" },
            mode: 'copy'
        ]
    }

 withName: REPORT {
        memory = { 32.GB }
        cpus = {$params.report_n_cores}
        time = { 2.h * task.attempt }
        maxRetries = 2
        publishDir = [
            path: { "${params.outdir}/report/" },
            mode: 'copy'
        ]
    }
}
