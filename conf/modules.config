process {   
  
 withName: DOWNSAMPLE {  
        memory = { 16.GB }
        // only the QC figure, the target QC tables, the cell counts and the
        // target expression table are published; the per-identity RDS
        // objects stay in the work dir, since they are large and purely
        // intermediate
        publishDir = [
            path: { "${params.outdir}/downsample/" },
            mode: 'copy',
            pattern: "{*.png,target_qc.tsv,targets_qc.txt,cell_counts.tsv,target_expression.tsv}"
        ]
    }
   
 withName: GENIE3 {
	memory = { 16.GB }
        cpus = { params.n_cores }
        publishDir = [
            path: { "${params.outdir}/genie3/" },
            mode: 'copy'
        ]
    }

 withName: SCTENIFOLDKNK_BUILD {
	// The expensive half of scTenifoldKnk (bootstrap networks + tensor
	// decomposition), once per cell type. cpus must match params.n_cores
	// the same way it does for the other network processes, or the local
	// executor stops serializing these tasks and scTenifoldNet's internal
	// per-gene-regression parallelism oversubscribes the node. Nothing is
	// published: the network is intermediate, read only by SCTENIFOLDKNK_KO.
	// The network holds every gene detected in more than --sctknk_min_pct
	// of a cell type's cells, and the tensor decomposition's memory grows
	// with the square of that count: a 7,000-gene cell type peaked near
	// 15 GB, so 24 GB leaves headroom. The module hands this figure to R
	// as its heap limit.
	memory = { 24.GB }
        cpus = { params.n_cores }
    }

 withName: SCTENIFOLDKNK_KO {
	// Runs once per (cell type, target) pair rather than once per cell
	// type -- see main.nf -- so a run with several targets launches far
	// more of these than the other network processes. Each is only the
	// knockout, manifold alignment and dRegulation on a network
	// SCTENIFOLDKNK_BUILD already made, but the alignment is an
	// eigendecomposition of a 2n x 2n matrix over n genes, so memory stays
	// generous. cpus follows n_cores for the same serialization reason.
	//
	// The per-pair tables are not published: they are purely intermediate
	// and there is one per cell type x target, so only the single merged
	// table MERGE_SCTENIFOLDKNK writes is kept. The plotKO() PDFs are, when
	// --sctknk_plot asks for them.
	memory = { 16.GB }
        cpus = { params.n_cores }
        publishDir = [
            path: { "${params.outdir}/sctknk/plots/" },
            mode: 'copy',
            pattern: "*.pdf"
        ]
    }

 withName: SCRANK {
	memory = { 64.GB }
        cpus = { params.n_cores }
        publishDir = [
            path: { "${params.outdir}/scrank/" },
            mode: 'copy'
        ]
    }

 withName: HDWGCNA {
	memory = { 24.GB }
        cpus = { params.n_cores }
        publishDir = [
            path: { "${params.outdir}/hdwgcna/" },
            mode: 'copy'
        ]
    }

 withName: RANK_SCORE {
        memory = { 64.GB }
        cpus   = 4
    }

 withName: MERGE {
        memory = { 2.GB }
        publishDir = [
            path: { "${params.outdir}/rank_scores/" },
            mode: 'copy'
        ]
    }

 withName: MERGE_SCTENIFOLDKNK {
        memory = { 2.GB }
        publishDir = [
            path: { "${params.outdir}/sctknk/" },
            mode: 'copy'
        ]
    }

 withName: GSEA_SCTENIFOLDKNK {
        // One task over the already-merged table, not one per pair, so this
        // stays small however many knockouts the run did.
        memory = { 8.GB }
        cpus   = 2
        publishDir = [
            path: { "${params.outdir}/sctknk/" },
            mode: 'copy'
        ]
    }

 withName: REPORT {
        memory = { 4.GB }
        publishDir = [
            path: { "${params.outdir}/report/" },
            mode: 'copy'
        ]
    }
}
