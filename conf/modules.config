process {   
  
 withName: DOWNSAMPLE {  
        memory = { 16.GB }
        // only the QC figure is published; the per-identity RDS objects stay in
        // the work dir, since they are large and purely intermediate
        publishDir = [
            path: { "${params.outdir}/downsample/" },
            mode: 'copy',
            pattern: "*.png"
        ]
    }
   
 withName: GENIE3 {
	memory = { 16.GB }
        cpus = {$params.n_cores}
        publishDir = [
            path: { "${params.outdir}/genie3/" },
            mode: 'copy'
        ]
    }

 withName: SCTENIFOLDNET {
	memory = { 16.GB }
        cpus = {$params.n_cores}
        publishDir = [
            path: { "${params.outdir}/sctnet/" },
            mode: 'copy'
        ]
    }

 withName: SCRANK {
	memory = { 64.GB }
        cpus = {$params.n_cores}
        publishDir = [
            path: { "${params.outdir}/scrank/" },
            mode: 'copy'
        ]
    }

 withName: HDWGCNA {
	memory = { 24.GB }
        cpus = { params.n_cores }
        publishDir = [
            path: { "${params.outdir}/hdwgcna/" },
            mode: 'copy'
        ]
    }

 withName: RANK_SCORE {
        memory = { 16.GB }
    }

 withName: MERGE {
        memory = { 2.GB }
        publishDir = [
            path: { "${params.outdir}/rank_scores/" },
            mode: 'copy'
        ]
    }

 withName: REPORT {
        memory = { 4.GB }
        publishDir = [
            path: { "${params.outdir}/report/" },
            mode: 'copy'
        ]
    }
}
