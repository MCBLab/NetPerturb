process {   
  
 withName: DOWNSAMPLE {  
        memory = { 16.GB }
        // only the QC figure and the target QC tables are published; the
        // per-identity RDS objects stay in the work dir, since they are large
        // and purely intermediate
        publishDir = [
            path: { "${params.outdir}/downsample/" },
            mode: 'copy',
            pattern: "{*.png,target_qc.tsv,targets_qc.txt}"
        ]
    }
   
 withName: GENIE3 {
	memory = { 16.GB }
        cpus = { params.n_cores }
        publishDir = [
            path: { "${params.outdir}/genie3/" },
            mode: 'copy'
        ]
    }

 withName: SCTENIFOLDKNK {
	// Runs once per (cell type, gene) pair rather than once per cell
	// type -- see main.nf -- so a run with several targets launches far
	// more of these than the other network processes. cpus must match
	// params.n_cores the same way it does for them, or the local
	// executor stops serializing these tasks and their internal
	// per-gene-regression parallelism (inherited from scTenifoldNet)
	// oversubscribes the node exactly the way GENIE3/SCRANK/SCTENIFOLDNET
	// did before that was fixed.
	//
	// Nothing is published from here: these per-pair tables are purely
	// intermediate and there is one per cell type x gene, so only the
	// single merged table MERGE_SCTENIFOLDKNK writes is kept.
	memory = { 16.GB }
        cpus = { params.n_cores }
    }

 withName: SCRANK {
	memory = { 64.GB }
        cpus = { params.n_cores }
        publishDir = [
            path: { "${params.outdir}/scrank/" },
            mode: 'copy'
        ]
    }

 withName: HDWGCNA {
	memory = { 24.GB }
        cpus = { params.n_cores }
        publishDir = [
            path: { "${params.outdir}/hdwgcna/" },
            mode: 'copy'
        ]
    }

 withName: RANK_SCORE {
        memory = { 64.GB }
        cpus   = 4
    }

 withName: MERGE {
        memory = { 2.GB }
        publishDir = [
            path: { "${params.outdir}/rank_scores/" },
            mode: 'copy'
        ]
    }

 withName: MERGE_SCTENIFOLDKNK {
        memory = { 2.GB }
        publishDir = [
            path: { "${params.outdir}/sctknk/" },
            mode: 'copy'
        ]
    }

 withName: GSEA_SCTENIFOLDKNK {
        // One task over the already-merged table, not one per pair, so this
        // stays small however many knockouts the run did.
        memory = { 8.GB }
        cpus   = 2
        publishDir = [
            path: { "${params.outdir}/sctknk/" },
            mode: 'copy'
        ]
    }

 withName: REPORT {
        memory = { 4.GB }
        publishDir = [
            path: { "${params.outdir}/report/" },
            mode: 'copy'
        ]
    }
}
