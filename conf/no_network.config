// Overrides the test_vangalen profile's `network = "hdwgcna"` default to
// null, so only the --sctknk track runs: SCTENIFOLDKNK_BUILD/NULL/KO and
// MERGE_SCTENIFOLDKNK, with no RANK_SCORE/MERGE/NETWORK_QC/REPORT (those
// are all gated on `network` being truthy in main.nf).
params {
    network = null
}
