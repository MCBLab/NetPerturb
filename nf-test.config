config {

    // module tests live next to their module, pipeline tests under tests/
    testsDir "."
    workDir ".nf-test"
    configFile "tests/nextflow.config"

    /*
    The end to end test pulls containers and downloads the test object, so it is
    kept out of the default run. Invoke it by path when you want it:

        nf-test test tests/integration.nf.test --profile test,singularity
    */
    ignore 'tests/integration.nf.test'
}
