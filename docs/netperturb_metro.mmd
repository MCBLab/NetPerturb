%%metro title: MCBLab/NetPerturb
%%metro style: dark
%%metro legend: bl
%%metro compact_offsets: true

%% genie3/scrank/hdwgcna are the --network methods and are mutually
%% exclusive: a run rides exactly one of them end to end. sctknk is not one
%% of them -- it is its own line, switched on with --sctknk, and runs either
%% alone (terminating at sctknk_txt) or in parallel with one of the other
%% three (additionally transferring into that run's report -- the segment at
%% the bottom). Its enrichment station runs only when --gsea_gmt is given.
%%metro line: genie3  | --network genie3            (GENIE3)         | #2db572
%%metro line: scrank  | --network scrank            (scRank)         | #e6550d
%%metro line: hdwgcna | --network hdwgcna           (hdWGCNA)        | #756bb1
%%metro line: sctknk  | --sctknk                    (scTenifoldKnk)  | #0570b0

%% Pipeline inputs (--obj, --target) and published outputs
%%metro file:  obj_in      | RDS  | --obj
%%metro file:  targets_in  | TXT  | --target
%%metro files: net_rds     | RDS  | Network weights
%%metro file:  score_txt   | TXT  | Scores
%%metro file:  conn_txt    | TXT  | Top connections
%%metro file:  sctknk_txt  | TXT  | DR genes
%%metro file:  gsea_txt    | TXT  | GSEA
%%metro file:  umap_png    | PNG  | UMAP
%%metro file:  report_html | HTML | Report

%% Lift published outputs off the track so they hang above it as termini
%%metro off_track: umap_png, net_rds, score_txt, conn_txt, sctknk_txt, gsea_txt

%% Station -> Nextflow process, for `nf-metro serve` live overlays
%%metro process: downsample    | DOWNSAMPLE
%%metro process: genie3_net    | GENIE3
%%metro process: scrank_net    | SCRANK
%%metro process: hdwgcna_net   | HDWGCNA
%%metro process: sctenifoldknk | SCTENIFOLDKNK
%%metro process: rank_score    | RANK_SCORE
%%metro process: merge         | MERGE
%%metro process: merge_sctknk  | MERGE_SCTENIFOLDKNK
%%metro process: gsea          | GSEA_SCTENIFOLDKNK
%%metro process: report        | REPORT

graph LR
    subgraph input [Input & downsampling]
        %%metro exit: right | genie3, scrank, hdwgcna, sctknk
        obj_in[ ]
        targets_in[ ]
        downsample[Downsample & split]
        umap_png[ ]

        obj_in -->|genie3,scrank,hdwgcna,sctknk| downsample
        targets_in -->|genie3,scrank,hdwgcna,sctknk| downsample
        downsample -->|genie3,scrank,hdwgcna,sctknk| umap_png
    end

    subgraph inference [Network inference]
        %%metro entry: left | genie3, scrank, hdwgcna
        %%metro exit: right | genie3, scrank, hdwgcna
        genie3_net[GENIE3]
        scrank_net[scRank]
        hdwgcna_net[hdWGCNA]
        collect_nets[Collect networks]
        net_rds[ ]

        genie3_net -->|genie3| collect_nets
        scrank_net -->|scrank| collect_nets
        hdwgcna_net -->|hdwgcna| collect_nets
        collect_nets -->|genie3,scrank,hdwgcna| net_rds
    end

    subgraph knockout [Virtual knockout]
        %%metro entry: left | sctknk
        %%metro exit: right | sctknk
        %% Target-specific by construction, so this runs once per cell
        %% identity x gene pair rather than once per identity. scTenifoldKnk
        %% knocks out exactly one gene per run, so a ';'-joined target is
        %% split into one knockout per gene, deduplicated across the file.
        sctenifoldknk[scTenifoldKnk]
        merge_sctknk[Merge]
        sctknk_txt[ ]
        gsea[Gene set enrichment]
        gsea_txt[ ]

        sctenifoldknk -->|sctknk| merge_sctknk
        merge_sctknk -->|sctknk| sctknk_txt

        %% Only with --gsea_gmt: the gene sets come from a file and nothing is
        %% fetched, so no GMT simply means no enrichment.
        merge_sctknk -->|sctknk| gsea
        gsea -->|sctknk| gsea_txt
    end

    subgraph scoring [Perturbation scoring]
        %%metro entry: left | genie3, scrank, hdwgcna
        %%metro exit: right | genie3, scrank, hdwgcna
        rank_score[Rank score & top edges]
        merge[Merge]
        score_txt[ ]
        conn_txt[ ]

        rank_score -->|genie3,scrank,hdwgcna| merge
        merge -->|genie3,scrank,hdwgcna| score_txt
        merge -->|genie3,scrank,hdwgcna| conn_txt
    end

    subgraph reporting [Reporting]
        %%metro entry: left | genie3, scrank, hdwgcna
        report[Quarto report]
        report_html[ ]

        report -->|genie3,scrank,hdwgcna| report_html
    end

    %% The per-identity objects fan out into whichever method was selected;
    %% sctknk additionally fans out over every knocked-out gene, not shown as
    %% a separate line here since the map tracks pipeline stages, not genes.
    downsample -->|genie3| genie3_net
    downsample -->|scrank| scrank_net
    downsample -->|hdwgcna| hdwgcna_net
    downsample -->|sctknk| sctenifoldknk

    %% All per-identity networks are collected and scored against every target.
    collect_nets -->|genie3,scrank,hdwgcna| rank_score

    %% Only the merged score table reaches the report. The top-connections
    %% table beside it is published for downstream use and no longer rendered:
    %% its figure was repointed at the knockout networks below. REPORT also
    %% embeds the UMAP published in section 1; that feed is left off the map,
    %% since a section 1 -> section 5 edge would sweep the whole width and read
    %% as a route rather than as the side artefact it is.
    merge -->|genie3,scrank,hdwgcna| report

    %% When a --network track is running too, sctknk transfers its DR gene
    %% table into that same report as its last two sections. This leg only runs
    %% in that case -- a --sctknk run with no --network stops at sctknk_txt
    %% above and never reaches report -- but it is drawn as an ordinary segment
    %% because nf-metro's grammar takes only -->, --- and ==>, and discards the
    %% arrow kind anyway: a Mermaid dashed -.-> is dropped with a warning and
    %% the leg disappears from the map entirely, which is what happened here
    %% until now.
    merge_sctknk -->|sctknk| report
    gsea -->|sctknk| report
